# Copy to .env and fill in. Never commit .env.
# `pnpm dev` loads this file (node --env-file-if-exists). Values below match compose.yaml for local dev.

# --- Database (change setup-monorepo) ----------------------------------

# Application role: not a table owner, no BYPASSRLS (used by api).
DATABASE_URL=postgres://dw_app:dw_app_dev@localhost:5432/dw
# Owner role: runs migrations only (pnpm db:migrate).
MIGRATION_DATABASE_URL=postgres://dw_owner:dw_owner_dev@localhost:5432/dw

# --- Optional (defaults shown) ------------------------------------------

PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# development | test | production
NODE_ENV=development

# --- Auth (add-tenancy-and-auth) ----------------------------------------

# At least 32 characters (openssl rand -hex 32). Dev value only — never reuse it.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Where the browser opens the app (Vite proxies /api to the api in dev).
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Optional: both or neither. Empty → the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Behind a reverse proxy (Caddy in prod): true. Leave false in dev.
TRUST_PROXY=false

# --- Email ---------------------------------------------------------------

# Mailpit from compose.yaml; read the emails at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Digital Workers <noreply@dw.local>

# --- Secrets and platform admin (add-llm-gateway-and-credit) -------------

# Master key for stored secrets (provider API keys, later bot tokens). 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dev value only. Back it up separately from database backups: losing it loses every stored key.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
# Platform admins, comma-separated. They must not belong to any company and must enable TOTP.
# Model API keys are not env variables: the platform admin enters them in /platform/keys.
PLATFORM_ADMIN_EMAILS=

# --- Worker runtime (add-worker-runtime-webchat) ------------------------

# apps/runner also reads DATABASE_URL, ENCRYPTION_KEY, SMTP_URL, MAIL_FROM, WEB_ORIGIN above.
# One model for every worker (0.2 #131): provider:model. It needs a price in /platform/prices.
WORKER_MODEL=anthropic:claude-sonnet-5-5
# Task.run jobs processed at the same time (shared by all companies, 0.2 #140).
RUNNER_CONCURRENCY=4
# Limits of one Task (0.2 #123): model calls, seconds, VNĐ.
TASK_MAX_STEPS=12
TASK_MAX_SECONDS=180
TASK_MAX_CHARGE_VND=8000
# Runner /health/ready
HEALTH_PORT=3001

# --- Not used yet: required by later changes ----------------------------

# Public base URL (webhooks for Telegram / Zalo) — deploy-staging / add-channel-telegram
PUBLIC_BASE_URL=
