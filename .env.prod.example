# Production / staging secrets for compose.prod.yaml. Copy to .env.prod (never commit it):
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d
# Generate URL-safe passwords: openssl rand -hex 24

SITE_ADDRESS=localhost
POSTGRES_PASSWORD=change-me-superuser
DW_OWNER_PASSWORD=change-me-owner
DW_APP_PASSWORD=change-me-app
LOG_LEVEL=info

# --- Auth (add-tenancy-and-auth) -----------------------------------------
# Public origin of the site, as users type it (https in production).
PUBLIC_URL=https://localhost
# At least 32 random characters: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-auth-secret-at-least-32-chars
# Optional: both or neither. Without them the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (provider chosen in deploy-staging, 0.2 #042) -----------------
SMTP_URL=smtp://user:password@smtp.example.vn:587
MAIL_FROM=Digital Workers <noreply@example.vn>

# --- Secrets and platform admin (add-llm-gateway-and-credit) -------------
# 32 random bytes, base64: openssl rand -base64 32. The placeholder below is rejected
# at startup on purpose, so a deployment cannot run with a published key.
# Keep a copy outside the server and apart from database backups: without it the
# stored provider API keys cannot be decrypted.
ENCRYPTION_KEY=change-me
# Comma-separated; these accounts must not belong to any company and must enable TOTP.
PLATFORM_ADMIN_EMAILS=
